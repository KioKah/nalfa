<div class="combat-overview">
  {{>
    "systems/nalfa/templates/partials/character/combat-health-card.hbs"
    sysData=sysData
    config=config
    isKO=isKO
    deathTick=deathTick
    hpTooltip=hpTooltip
  }}
  {{>
    "systems/nalfa/templates/partials/character/combat-defense-card.hbs"
    sysData=sysData
    config=config
    defenseTooltip=defenseTooltip
    evasionTooltip=evasionTooltip
  }}
  {{#if isCharacter}}
    {{>
      "systems/nalfa/templates/partials/character/character-status-card.hbs"
      sysData=sysData
      isEditable=isEditable
      fatigue=fatigue
    }}
  {{/if}}
</div>
