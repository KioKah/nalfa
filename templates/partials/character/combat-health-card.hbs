<div class="combat-overview__card combat-overview__card--health">
  <div class="combat-overview__line combat-overview__line--primary">
    <span class="combat-overview__metric-label combat-overview__metric-label--hp">
      <i class="fa-solid fa-heart" aria-hidden="true"></i>
      <span>PV</span>
    </span>
    <input
      name="system.attributes.hp.value"
      type="number"
      value="{{sysData.attributes.hp.value}}"
      data-dtype="Number"
    />
    <span class="field__separator">/</span>
    <span class="field__total" data-tooltip="{{hpTooltip}}">
      {{sysData.attributes.hp.max}}
    </span>
    {{#if (eq sysData.ui.valueMode "base")}}
      <input
        class="combat-overview__hp-edit-input"
        name="system.attributes.hp.base"
        type="number"
        value="{{sysData.attributes.hp.base}}"
        data-dtype="Number"
      />
    {{else if (eq sysData.ui.valueMode "alt")}}
      <input
        class="combat-overview__hp-edit-input"
        name="system.attributes.hp.alt"
        type="number"
        value="{{sysData.attributes.hp.alt}}"
        data-dtype="Number"
      />
    {{/if}}
    <span class="combat-overview__line-spacer"></span>
    <label class="combat-overview__compact-field" data-tooltip="PV temporaires">
      <i class="fa-light fa-shield-plus" aria-hidden="true"></i>
      <span class="combat-overview__compact-label">PV temporaires</span>
      <input
        name="system.attributes.hp.abso"
        type="number"
        value="{{sysData.attributes.hp.abso}}"
        data-dtype="Number"
      />
    </label>
  </div>
  {{#if isKO}}
    {{#if deathTick.isDead}}
      <div class="combat-overview__ko-status combat-overview__ko-status--dead">
        <i class="fa-light fa-skull" aria-hidden="true"></i>
        <strong>Mort</strong>
        <span class="field__meta">PV négatifs au-delà du maximum</span>
      </div>
    {{else}}
      <div class="combat-overview__ko-status">
        <span class="ko-indicator">KO</span>
        <span>Mort dans</span>
        <strong>{{deathTick.turnsToDeath}}</strong>
        <span>{{#if (eq deathTick.turnsToDeath 1)}}tour{{else}}tours{{/if}}</span>
        <span class="field__meta">−{{deathTick.lossPerTurn}} PV / tour</span>
      </div>
    {{/if}}
  {{else}}
    <div class="combat-overview__line combat-overview__line--resource">
      <span class="combat-overview__metric-label nalfa-resource__label">
        <i class="fa-light fa-sparkle nalfa-resource__icon" aria-hidden="true"></i>
        <span>Nalfa</span>
      </span>
      <input
        name="system.nalfa.value"
        type="number"
        value="{{sysData.nalfa.value}}"
        data-dtype="Number"
      />
      <span class="field__separator">/</span>
      <input
        name="system.nalfa.max"
        type="number"
        value="{{sysData.nalfa.max}}"
        data-dtype="Number"
      />
    </div>
  {{/if}}

  {{#unless (eq sysData.ui.valueMode "values")}}
    <div class="combat-overview__profile-row">
      <label class="field field--inline combat-overview__entry">
        <span class="field__label">Profil de santé</span>
        <select class="combat-overview__profile-select" name="system.profile">
          {{selectOptions config.profiles selected=sysData.profile}}
        </select>
      </label>
      {{#if isKO}}
        <div class="combat-overview__line combat-overview__line--resource">
          <span class="combat-overview__metric-label nalfa-resource__label">
            <i class="fa-light fa-sparkle nalfa-resource__icon" aria-hidden="true"></i>
            <span>Nalfa</span>
          </span>
          <input
            name="system.nalfa.value"
            type="number"
            value="{{sysData.nalfa.value}}"
            data-dtype="Number"
          />
          <span class="field__separator">/</span>
          <input
            name="system.nalfa.max"
            type="number"
            value="{{sysData.nalfa.max}}"
            data-dtype="Number"
          />
        </div>
      {{else}}
        <span></span>
      {{/if}}
    </div>
  {{/unless}}
</div>
