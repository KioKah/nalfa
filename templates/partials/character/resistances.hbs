<section class="sheet-section resistance-overview">
  <div class="resistance-overview__heading">
    <h2>Résistances &amp; vulnérabilités</h2>
    <span class="field__meta">×0 immunité · ×0,5 résistance · ×2 vulnérabilité</span>
  </div>

  {{#if (eq sysData.ui.valueMode "values")}}
    {{#if hasModifiedResistances}}
      <div class="resistance-overview__grid resistance-overview__grid--summary">
        {{#each resistanceRows}}
          {{#unless isDefault}}
            <div
              class="resistance-overview__card
                resistance-overview__card--{{state}}
                color-{{key}}"
            >
              <span class="resistance-overview__label">{{label}}</span>
              <div class="resistance-overview__readout">
                <span>&times;{{compactNumber usedCoef 4}}</span>
                {{#unless (eq usedValue 0)}}
                  <span>−{{compactNumber usedValue 4}}</span>
                {{/unless}}
              </div>
            </div>
          {{/unless}}
        {{/each}}
      </div>
    {{else}}
      <div class="resistance-overview__empty">
        <i class="fa-light fa-shield-check" aria-hidden="true"></i>
        <span>Aucune résistance ou vulnérabilité particulière</span>
      </div>
    {{/if}}
  {{else}}
    <div class="resistance-overview__grid resistance-overview__grid--editor">
      {{#each resistanceRows}}
        <label class="resistance-overview__card color-{{key}}">
          <span class="resistance-overview__label">{{label}}</span>
          {{#if (eq ../sysData.ui.valueMode "base")}}
            <div class="resistance-overview__inputs">
              <span>&times;</span>
              <input
                name="system.attributes.resistances.{{key}}.coef"
                type="number"
                value="{{coef}}"
                step="0.1"
                data-dtype="Number"
              />
              <span>−</span>
              <input
                name="system.attributes.resistances.{{key}}.value"
                type="number"
                value="{{value}}"
                data-dtype="Number"
              />
            </div>
          {{else}}
            <div class="resistance-overview__inputs">
              <span>&times;</span>
              <input
                name="system.attributes.resistances.{{key}}.alt_mult"
                type="number"
                value="{{alt_mult}}"
                step="0.1"
                data-dtype="Number"
              />
              <span>−</span>
              <input
                name="system.attributes.resistances.{{key}}.alt"
                type="number"
                value="{{alt}}"
                data-dtype="Number"
              />
            </div>
          {{/if}}
        </label>
      {{/each}}
    </div>
  {{/if}}
</section>
