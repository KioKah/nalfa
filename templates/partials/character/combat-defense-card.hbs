<div class="combat-overview__card">
  <div class="combat-overview__line combat-overview__line--primary">
    <div class="field field--inline combat-overview__stat">
      <span class="combat-overview__metric-label combat-overview__metric-label--defense">
        <i class="fa-light fa-shield" aria-hidden="true"></i>
        <span>Défense</span>
      </span>
      <span
        class="field__total combat-overview__value"
        data-tooltip="{{defenseTooltip}}"
      >
        {{sysData.attributes.defense.value}}
      </span>
      <input
        class="value-mode value-mode--base"
        name="system.attributes.defense.base"
        type="number"
        value="{{sysData.attributes.defense.base}}"
        data-dtype="Number"
      />
      <input
        class="value-mode value-mode--alt"
        name="system.attributes.defense.alt"
        type="number"
        value="{{sysData.attributes.defense.alt}}"
        data-dtype="Number"
      />
    </div>
  </div>
  <div class="combat-overview__line">
    <div class="field field--inline combat-overview__stat">
      <span class="combat-overview__metric-label combat-overview__metric-label--evasion">
        <i class="fa-light fa-person-running" aria-hidden="true"></i>
        <span>Évasion</span>
      </span>
      <span
        class="field__total combat-overview__value"
        data-tooltip="{{evasionTooltip}}"
      >
        {{sysData.attributes.evasion.value}}
      </span>
      <input
        class="value-mode value-mode--base"
        name="system.attributes.evasion.base"
        type="number"
        value="{{sysData.attributes.evasion.base}}"
        data-dtype="Number"
      />
      <input
        class="value-mode value-mode--alt"
        name="system.attributes.evasion.alt"
        type="number"
        value="{{sysData.attributes.evasion.alt}}"
        data-dtype="Number"
      />
    </div>
  </div>
</div>
