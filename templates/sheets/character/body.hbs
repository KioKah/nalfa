<section class="sheet-body" data-value-mode="{{sysData.ui.valueMode}}">
  <div class="tab {{tabs.actions.cssClass}}" data-group="primary" data-tab="actions">
    {{>
      "systems/nalfa/templates/partials/character/actions-overview.hbs"
      actorActions=actorActions
      rollable=rollable
      isEditable=isEditable
    }}
  </div>

  <div class="tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory">
    {{>
      "systems/nalfa/templates/partials/character/inventory-overview.hbs"
      inventoryRows=inventoryRows
      inventoryBrowser=inventoryBrowser
      isEditable=isEditable
    }}
  </div>

  <div class="tab {{tabs.bio.cssClass}}" data-group="primary" data-tab="bio">
    {{>
      "systems/nalfa/templates/partials/character/bio-overview.hbs"
      actor=actor
      sysData=sysData
      config=config
      bioEnriched=bioEnriched
      hasBioContent=hasBioContent
      readonly=readonly
    }}
  </div>

  <div class="tab {{tabs.character.cssClass}}" data-group="primary" data-tab="character">
    <div class="sheet-section">
      {{>
        "systems/nalfa/templates/partials/character/combat-overview.hbs"
        sysData=sysData
        config=config
        isKO=isKO
        deathTick=deathTick
        hpTooltip=hpTooltip
        defenseTooltip=defenseTooltip
        evasionTooltip=evasionTooltip
        fatigue=fatigue
        isCharacter=isCharacter
        isEditable=isEditable
      }}
    </div>

    {{>
      "systems/nalfa/templates/partials/character/stats-skills.hbs"
      sysData=sysData
      config=config
      rollable=rollable
    }}

    {{>
      "systems/nalfa/templates/partials/character/resistances.hbs"
      sysData=sysData
      resistanceRows=resistanceRows
      hasModifiedResistances=hasModifiedResistances
    }}
  </div>

  <div class="tab {{tabs.combat.cssClass}}" data-group="primary" data-tab="combat">
    {{>
      "systems/nalfa/templates/partials/character/combat-summary.hbs"
      sysData=sysData
      combatSummary=combatSummary
      isEditable=isEditable
    }}
    {{>
      "systems/nalfa/templates/partials/character/roll-stats.hbs"
      sysData=sysData
      config=config
    }}
    {{>
      "systems/nalfa/templates/partials/character/action-resources.hbs"
      sysData=sysData
      combatResources=combatResources
      stateProfile=stateProfile
      isEditable=isEditable
    }}
    {{>
      "systems/nalfa/templates/partials/character/combat-action-grid.hbs"
      combatHotbar=combatHotbar
      isEditable=isEditable
    }}
  </div>

  <div class="tab {{tabs.states.cssClass}}" data-group="primary" data-tab="states">
    {{>
      "systems/nalfa/templates/partials/character/states-overview.hbs"
      stateRows=stateRows
      isEditable=isEditable
    }}
  </div>

  {{#if isEditable}}
    {{>
      "systems/nalfa/templates/partials/character/value-mode-toggle.hbs"
      sysData=sysData
      config=config
    }}
  {{/if}}
</section>
